# SISMO911 — example secrets. Copy to .dev.vars (local) — never commit real values.
# Cloudflare auth is handled by `wrangler login` / CI env, not here.

# --- Social ingestion adapters (optional; stubs return [] until set) ---
X_BEARER_TOKEN=
META_GRAPH_TOKEN=
TIKTOK_RESEARCH_TOKEN=
APIFY_TOKEN=

# --- Production hardening ---
# Required to create the first admin user in a new database.
ADMIN_BOOTSTRAP_TOKEN=

# Optional comma-separated extra allowed origins for API CORS, e.g. preview URLs.
ALLOWED_ORIGINS=

# Cloudflare Access app values. Set in Wrangler/Cloudflare, not as public client config.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# --- Telemedicina text confirmations (Twilio SMS + WhatsApp) ---
# Optional. When unset, text messages no-op gracefully (email still sends).
# Set as Worker secrets in prod: `wrangler secret put TWILIO_ACCOUNT_SID` etc.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=          # E.164 SMS-capable number, e.g. +15551234567
TWILIO_WHATSAPP_FROM=     # E.164 of the approved Twilio WhatsApp sender
